    "verify": "bun tools/verify.ts",
    "kit": "bun tools/kit/cli.ts",
    "decokit": "bun tools/decokit/run.ts",
    "block": "bun tools/plan/block.ts",
    "world": "bun tools/world/export.ts",
    "life": "bun tools/life/cli.ts",
    "crew": "bun tools/crew/cards.ts",
    "ingest": "bun tools/rag/ingest.ts",
    "retrieve": "bun tools/rag/retrieval.ts",
    "typecheck": "tsc --noEmit",
