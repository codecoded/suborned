+{
+ "schema": "suborned.mission.adaptive/1",
+ "mission": "handover",
+ "id": "quiet-b",
+ "style": "prepared-quiet",
+ "note": "Route B as a person plays it, prepared: listen to the driver, pay him, tip the rivals off once their car has parked, reroute the patrol so the sweep is away at the pickup, bring the cell's car round when Vale's car is in, take Vale in the back seat, fight from the yard, Go when the car is free.",
+ "pace": "human",
+ "rules": [
