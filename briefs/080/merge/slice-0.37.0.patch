+  {"id":"board","op":"enforcer","do":"board","target":"car","when":["done:to-car","free:enforcer"],"retry":2},
+  {"id":"scout-back","op":"scout","do":"move","to":"d:Getaway bay","when":["log:enter.out"],"run":true},
+  {"id":"fixer-back","op":"fixer","do":"move","to":"d:Getaway bay","when":["log:enter.out"],"run":true},
+  {"id":"tech-back","op":"tech","do":"move","to":"d:Getaway bay","when":["log:enter.out"],"run":true},
+  {"id":"scout-in","op":"scout","do":"board","target":"car","when":["log:board.in","free:scout"],"retry":2},
+  {"id":"fixer-in","op":"fixer","do":"board","target":"car","when":["log:board.in","free:fixer"],"retry":2},
+  {"id":"tech-in","op":"tech","do":"board","target":"car","when":["log:board.in","free:tech"],"retry":2},
