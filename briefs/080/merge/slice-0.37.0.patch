+{
+ "schema": "suborned.mission.adaptive/1",
+ "mission": "handover",
+ "id": "quiet-b",
+ "style": "prepared-quiet",
+ "note": "Route B as a person plays it, prepared: listen to the driver, pay him, tip the rivals off once their car has parked, reroute the patrol so the sweep is away at the pickup, bring the cell's car round when Vale's car is in, take Vale in the back seat, fight from the yard, Go when the car is free.",
+ "pace": "human",
+ "rules": [
+  {"id":"scout-to-driver","op":"scout","do":"move","to":"d:Meet driver","when":["t>=:0:48"],"why":"the driver comes on at about 1:00: step in when he's there"},
+  {"id":"scout-off","op":"scout","do":"move","to":[7950,-4000]},
+  {"id":"fixer-off","op":"fixer","do":"move","to":[7950,-3850],"why":"out of the pickup camera's sight"},
+  {"id":"tech-to-cabinet","op":"tech","do":"move","to":"cabinet","run":true},
+  {"id":"listen","op":"scout","do":"listen","target":"driver","after":["scout-to-driver"],"when":["free:scout"]},
+  {"id":"pay","op":"fixer","do":"turn","target":"driver","approach":"pay","by":"4:40","when":["log:scout.listen.heard"],"retry":5},
+  {"id":"scout-to-watch","op":"scout","do":"move","to":[7950,-4000],"when":["log:scout.listen.heard"],"why":"the wait before the rivals park: out of the camera, in sight of the door"},
+  {"id":"watch-guard","op":"scout","do":"watch","target":"guard","when":["fin:scout-to-watch","free:scout"],"retry":3,"tries":3},
+  {"id":"scout-near-rivals","op":"scout","do":"move","to":[8600,-3400],"when":["log:scout.watch.watched"],"why":"out of the camera, near where the rivals will park"},
+  {"id":"fixer-away","op":"fixer","do":"move","to":[7950,-3850],"when":["log:turn.pay.turned"],"why":"back out of the camera's sight"},
+  {"id":"tip","op":"scout","do":"mislead","target":"rivals","when":["log:rivals.arrive","free:scout"],"retry":3,"why":"when the rivals' car has parked"},
+  {"id":"to-lone","op":"enforcer","do":"move","to":[-700,-3600],"when":["t>=:4:05"],"why":"the rival posted by the café terrace stands alone, out of the other two's sight"},
+  {"id":"td-lone","op":"enforcer","do":"takedown","target":"$nearest:enforcer","how":"knockout","when":["fin:to-lone"],"retry":1},
+  {"id":"enforcer-lane","op":"enforcer","do":"move","to":"d:Service lane","when":["fin:td-lone"],"why":"the lone rival's down: over to the yard"},
+  {"id":"reroute","op":"tech","do":"reroute","target":"patrol","when":["t>=:4:25","free:tech"],"retry":5,"why":"1:55 of sweep away, landing 30 s on: it has to cover the pickup and leave a person time on the Take"},
+  {"id":"tech-to-car","op":"tech","do":"move","to":"d:Getaway bay","when":["log:patrol.rerouted"],"run":true},
+  {"id":"tech-in","op":"tech","do":"board","target":"car","after":["tech-to-car"],"when":["free:tech"],"retry":2},
+  {"id":"scout-yard","op":"scout","do":"move","to":[7300,-1900],"when":["done:tip","t>=:4:40"]},
+  {"id":"fixer-yard","op":"fixer","do":"move","to":[7300,-1100],"when":["done:pay","t>=:4:40"]},
+  {"id":"drive","op":"tech","do":"drive-car","target":"service-drive","when":["done:take","left<=:enforcer:32","done:tech-in"],"retry":2,"interrupt":true,"why":"timed to the Take's ring, not to Vale's car: the car and the crew that runs after it arrive as he comes out, however late the Take began"},
+  {"id":"take","op":"enforcer","do":"take","when":["log:car.parks","done:enforcer-lane","free:enforcer"],"retry":1},
+  {"id":"predraw-scout","op":"scout","do":"draw","when":["done:take","left<=:enforcer:1"],"react":"expected","why":"the Take's ring is nearly closed: guns out as it lands, not before (drawn near a walking rival, they open fire and it's loud); the crew will shoot at a drawn agent before the carrier"},
+  {"id":"predraw-fixer","op":"fixer","do":"draw","with":"predraw-scout"},
+  {"id":"draw-late-scout","op":"scout","do":"draw","when":["log:fight.ambush","!drawn:scout"],"react":"expected"},
+  {"id":"draw-late-fixer","op":"fixer","do":"draw","with":"draw-late-scout"},
+  {"id":"focus-scout","op":"scout","do":"fire","target":"$nearest:scout","when":["log:fight.ambush","drawn:scout"],"retry":1,"react":"expected"},
+  {"id":"focus-fixer","op":"fixer","do":"fire","target":"$nearest:scout","with":"focus-scout"},
+  {"id":"to-drive","op":"enforcer","do":"move","to":"service-drive","when":["log:take.done","done:drive"],"retry":1,"react":"expected","why":"the Take's ring closing is the moment he's been waiting for"},
+  {"id":"board","op":"enforcer","do":"board","target":"car","when":["done:to-drive","free:enforcer"],"retry":1,"react":"expected"},
+  {"id":"go","op":"cell","do":"go","when":["fin:board","log:car.free"],"retry":1,"react":"expected","why":"Go when the car is free; retry if refused"},
+  {"id":"go-over","op":"cell","do":"go","when":["fin:board","log:fight.over"],"retry":1,"react":"expected","why":"the crew's gone, so the car's mark has nothing to clear"},
+  {"id":"rescue-move","op":"scout","do":"move","to":"service-drive","when":["fin:board","down:enforcer"],"interrupt":true,"why":"the Enforcer's down in the car with Vale: somebody has to drive"},
+  {"id":"rescue-board","op":"scout","do":"board","target":"car","when":["done:rescue-move","free:scout"],"retry":1}
+ ]
+}
