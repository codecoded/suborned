   "op": "scout",
   "do": "move",
   "to": "d:Meet driver",
   "when": [
    "t>=:0:48"
   ],
   "why": "the driver comes on at about 1:00"
  },
  {
   "id": "fixer-off",
   "op": "fixer",
   "do": "move",
   "to": [
    7950,
    -3850
   ],
   "why": "out of the pickup camera's sight"
  },
  {
