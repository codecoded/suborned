    "log:scout.listen.heard"
   ],
   "retry": 5,
   "why": "Help after the Listen: private, so the pickup camera records nothing (brief 096)"
  },
  {
   "id": "help-2",
   "op": "fixer",
   "do": "turn",
   "target": "driver",
   "approach": "help",
   "by": "5:20",
   "when": [
    "log:turn.help.not-yet"
   ],
   "unless": [
    "log:turn.help.turned"
   ],
   "retry": 5
  },
  {
