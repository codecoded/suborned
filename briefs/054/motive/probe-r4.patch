diff -ruN -x b base/sim/Suborned.Sim/GameCivSight.cs cone/sim/Suborned.Sim/GameCivSight.cs
--- base/sim/Suborned.Sim/GameCivSight.cs	1970-01-01 07:00:00
+++ cone/sim/Suborned.Sim/GameCivSight.cs	2026-10-24 00:24:11
@@ -0,0 +1,77 @@
+// Motive probe, brief 054 rev 4 (scratch only, never the engine): civilians see by a facing cone, and odd acts only at high Alert.
+using System;
+using System.Collections.Generic;
+namespace Suborned.Sim
+{
+    public sealed partial class Game
+    {
+        /// <summary>0 today; 1 cone + gate, unknown stops by a hashed facing; 2 unknown stops face the act (worst); 3 unknown stops see nothing (best).</summary>
+        public static int CivMode = int.Parse(Environment.GetEnvironmentVariable("CIV_MODE") ?? "1");
+        public static int CivGateAlert = int.Parse(Environment.GetEnvironmentVariable("CIV_GATE") ?? "2");
+        public static int CivReachCm = 1300, CivHalfCm = 2250; // ±60° to 13 m
+        public static bool CivStaffFacing = (Environment.GetEnvironmentVariable("CIV_STAFF") ?? "1") == "1"; // stop facings also feed staff (run noticing) and takedown awareness
+        public static int CivStaffConeMode = int.Parse(Environment.GetEnvironmentVariable("CIV_STAFFCONE") ?? "0"); static bool CivStaffCone => CivStaffConeMode > 0;
+        public static bool CivShotTurns = (Environment.GetEnvironmentVariable("CIV_SHOT") ?? "1") == "1";
+        bool heardNow;
+        public static bool CivShoutTurns = (Environment.GetEnvironmentVariable("CIV_SHOUT") ?? "1") == "1";  // a scream turns heads within witness range on a line
+        static Dictionary<string, Pt>? seatFace;
+        static readonly Pt[] Dirs8 = { new Pt(1000, 0), new Pt(707, 707), new Pt(0, 1000), new Pt(-707, 707), new Pt(-1000, 0), new Pt(-707, -707), new Pt(0, -1000), new Pt(707, -707) };
+        public static int CivUnknownStops, CivKnownStops;
+
+        static Dictionary<string, Pt> SeatFaces()
+        {
+            if (seatFace != null) return seatFace;
+            seatFace = new Dictionary<string, Pt>(StringComparer.Ordinal);
+            var root = Engine.FindRoot(System.IO.Directory.GetCurrentDirectory());
+            var f = System.IO.Path.Combine(root, "contracts/people/handover.seats.json");
+            if (!System.IO.File.Exists(f)) return seatFace;
+            var j = JNode.Parse(System.IO.File.ReadAllText(f));
+            foreach (var kv in j["tables"].Entries)
+            {
+                string tid = kv.Key; var t = kv.Value;
+                foreach (var c in t["chairs"].Items) seatFace[$"{tid}-seat-{c["chair"].Int()}"] = Pt.Of(c["face"]);
+            }
+            return seatFace;
+        }
+
+        /// <summary>The facing a stopped person has at their stop (Pulse's stop facings, proxied): a chair's face; a door stop faces out
+        /// of the door; a café stand faces the café door; anything else unknown (null).</summary>
+        Pt? StopFacing(string place, Pt at)
+        {
+            if (SeatFaces().TryGetValue(place, out var sf)) { CivKnownStops++; return sf; }
+            foreach (var e in S.Entrances)
+                if (G.Within(e.stand, at, 300) || G.Within(e.at, at, 300)) { var d = e.stand - e.at; if (d != new Pt(0, 0)) { CivKnownStops++; return d; } }
+            if (place.StartsWith("cafe-stand-", StringComparison.Ordinal) && People2 != null && People2.Places.TryGetValue("cafe-entrance", out var door)) { var d = door - at; if (d != new Pt(0, 0)) { CivKnownStops++; return d; } }
+            CivUnknownStops++;
+            return null;
+        }
+        Pt? CastFacing(Person p, Pt at)
+        {
+            if (ServerOf(p) is RoundsData.Server sv) { var q = RoundPoseAt(sv, EvRead(sv), Tick); return q.Face == new Pt(0, 0) ? (Pt?)null : q.Face; }
+            if (p == GuardP) { var gp = GuardPose(); return gp.HasValue && gp.Value.facing != new Pt(0, 0) ? gp.Value.facing : (Pt?)null; }
+            if (p == Driver) { var c = CarPos(); var d = c - at; return d == new Pt(0, 0) ? (Pt?)null : d; }
+            if (p == ValeP && Vale == ValeAt.Leaving) { int span = T(valeAtCarS) - T(valeExitsS); return valePath!.Heading(valePath.Length * Math.Min(span, Tick - T(valeExitsS)) / span); }
+            if (p == ValeP) { var c = CarPos(); var d = c - at; return d == new Pt(0, 0) ? (Pt?)null : d; }
+            return null;
+        }
+        Pt HashFacing(Person p) => Dirs8[Streams.Fnv1a32(p.Id + "/face") % 8];
+
+        /// <summary>Does person p at wp see point `at` (minor: an odd act, seen by civilians only from CivGateAlert)?</summary>
+        bool PSees(Person p, Pt wp, Pt at, bool minor = false)
+        {
+            if (CivMode == 0 || heardNow && CivShotTurns || !p.Civilian && !CivStaffCone) return G.Within(wp, at, witnessRange) && Sees(wp, at);
+            if (p.Civilian && minor && Alert < CivGateAlert) return false;
+            if (!p.Civilian && G.Within(wp, at, near)) return Sees(wp, at);
+            if (!G.Within(wp, at, !p.Civilian && CivStaffConeMode == 2 ? R.FacingReachCm * 1415 / 1000 : witnessRange)) return false;
+            var f = FacingOf(p) ?? (WalkerOf(p) == null ? CastFacing(p, wp) : null);
+            if (!f.HasValue)
+            {
+                if (CivMode == 2) return Sees(wp, at);
+                if (CivMode == 3) return false;
+                f = HashFacing(p);
+            }
+            if (!p.Civilian && CivStaffConeMode == 2) return (G.InCone(wp, f.Value, R.FacingReachCm, R.FacingHalfCm, 0, at)) && Sees(wp, at);
+            return G.InCone(wp, f.Value, CivReachCm, CivHalfCm, 0, at) && Sees(wp, at);
+        }
+    }
+}
