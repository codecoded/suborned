   "op": "scout",
   "do": "draw",
   "when": [
    "log:fight.ambush"
   ],
   "react": "expected"
  },
  {
   "id": "draw-fixer",
   "op": "fixer",
   "do": "draw",
   "with": "draw-all"
  },
  {
   "id": "draw-tech",
   "op": "tech",
   "do": "draw",
   "with": "draw-all"
  },
  {
   "id": "draw-enforcer",
   "op": "enforcer",
   "do": "draw",
   "with": "draw-all"
  },
  {
   "id": "focus-blocker-fixer",
   "op": "fixer",
   "do": "fire",
   "target": "$blocker",
   "when": [
    "blocker",
    "done:draw-all"
   ],
   "retry": 1
  },
  {
   "id": "focus-blocker-tech",
   "op": "tech",
   "do": "fire",
   "target": "$blocker",
   "with": "focus-blocker-fixer"
  },
  {
   "id": "pull-back",
   "op": "enforcer",
   "do": "move",
   "to": [
    3800,
    -5000
   ],
   "when": [
    "log:enforcer.warning"
   ],
   "interrupt": true,
   "why": "the Enforcer warns at 3 HP: off the line",
   "unless": [
    "done:to-car-2"
   ]
  },
  {
   "id": "to-car-2",
   "op": "enforcer",
   "do": "move",
   "to": "d:Getaway bay",
   "when": [
    "log:fight.over"
