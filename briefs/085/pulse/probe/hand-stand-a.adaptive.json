{
 "schema": "suborned.mission.adaptive/1",
 "mission": "handover",
 "id": "hand-stand-a",
 "style": "probe",
 "note": "Route A as a person plays it, prepared: Watch and Listen on Inez, Help till she's turned, the Loop planted while the last Help runs so it covers the entry, the call, in when the guard has walked off, then cover the car and fight from hold; Vale to the car when its mark clears.",
 "pace": "human",
 "rules": [
  {
   "id": "scout-to-inez",
   "op": "scout",
   "do": "move",
   "to": "beside-inez",
   "run": true
  },
  {
   "id": "tech-to-cabinet",
   "op": "tech",
   "do": "move",
   "to": "cabinet",
   "run": true
  },
  {
   "id": "fixer-to-court",
   "op": "fixer",
   "do": "move",
   "to": "d:Courtyard",
   "run": true
  },
  {
   "id": "enforcer-wait",
   "op": "enforcer",
   "do": "move",
   "to": [
    5650,
    -4750
   ],
   "why": "behind the entrance camera's cone, outside the guard's"
  },
  {
   "id": "watch-inez",
   "op": "scout",
   "do": "watch",
   "target": "waitress",
   "after": [
    "scout-to-inez"
   ],
   "when": [
    "free:scout"
   ]
  },
  {
   "id": "listen-inez",
   "op": "scout",
   "do": "listen",
   "target": "waitress",
   "when": [
    "log:scout.watch.watched"
   ]
  },
  {
   "id": "help-1",
   "op": "fixer",
   "do": "turn",
   "target": "waitress",
   "approach": "help",
   "when": [
    "log:scout.listen.heard"
   ]
  },
  {
   "id": "help-2",
   "op": "fixer",
   "do": "turn",
   "target": "waitress",
   "approach": "help",
   "when": [
    "log:turn.help.not-yet"
   ],
   "unless": [
    "log:turn.help.turned"
   ]
  },
  {
   "id": "loop",
   "op": "tech",
   "do": "loop",
   "target": "entrance",
   "after": [
    "help-2",
    "tech-to-cabinet"
   ],
   "why": "the last Help is 35 s and the Loop lands in 20: it comes up about when she's ready"
  },
  {
   "id": "loop-again",
   "op": "tech",
   "do": "loop",
   "target": "entrance",
   "when": [
    "done:loop",
    "!loopleft>=:25",
    "!log:enter.in"
   ],
   "repeat": 30,
   "retry": 5,
   "why": "the tape's running out and he isn't in yet: loop it again"
  },
  {
   "id": "enforcer-door-side",
   "op": "enforcer",
   "do": "move",
   "to": [
    6925,
    -4250
   ],
   "when": [
    "log:loop.on"
   ],
   "why": "once the camera's blind, to the service end of the west face, out of the guard's cone",
   "unless": [
    "log:call.waitress"
   ]
  },
  {
   "id": "call",
   "op": "fixer",
   "do": "call",
   "target": "waitress",
   "when": [
    "log:turn.help.turned",
    "loopleft>=:40"
   ],
   "retry": 2
  },
  {
   "id": "to-door",
   "op": "enforcer",
   "do": "move",
   "to": "d:Office entrance",
   "when": [
    "log:call.waitress"
   ],
   "run": true
  },
  {
   "id": "enter",
   "op": "enforcer",
   "do": "enter",
   "when": [
    "done:to-door",
    "free:enforcer",
    "loopleft>=:3"
   ],
   "retry": 1
  },
  {
   "id": "fixer-post",
   "op": "fixer",
   "do": "move",
   "to": [
    725,
    -5025
   ],
   "when": [
    "log:call.waitress"
   ]
  },
  {
   "id": "scout-post",
   "op": "scout",
   "do": "move",
   "to": [
    725,
    -4625
   ],
   "when": [
    "log:call.waitress"
   ]
  },
  {
   "id": "tech-post",
   "op": "tech",
   "do": "move",
   "to": [
    675,
    -4625
   ],
   "when": [
    "log:enter.in"
   ]
  },
  {
   "id": "enforcer-hold",
   "op": "enforcer",
   "do": "move",
