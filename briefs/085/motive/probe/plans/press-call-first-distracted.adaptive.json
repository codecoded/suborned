{"schema": "suborned.mission.adaptive/1", "mission": "handover", "id": "press-call-first-distracted", "style": "prepared-quiet", "note": "", "pace": "distracted", "rules": [{"id": "scout-to-inez", "op": "scout", "do": "move", "to": "beside-inez", "run": true}, {"id": "tech-to-cabinet", "op": "tech", "do": "move", "to": "cabinet", "run": true}, {"id": "fixer-to-court", "op": "fixer", "do": "move", "to": "d:Courtyard", "run": true}, {"id": "watch-inez", "op": "scout", "do": "watch", "target": "waitress", "after": ["scout-to-inez"], "when": ["free:scout"]}, {"id": "listen-inez", "op": "scout", "do": "listen", "target": "waitress", "when": ["log:scout.watch.watched"]}, {"id": "press", "op": "fixer", "do": "turn", "target": "waitress", "approach": "pressure", "when": ["log:scout.listen.heard"]}, {"id": "loop", "op": "tech", "do": "loop", "target": "entrance", "after": ["call", "tech-to-cabinet"], "why": "the last Help is 35 s and the Loop lands in 20: it comes up about when she's ready"}, {"id": "loop-again", "op": "tech", "do": "loop", "target": "entrance", "when": ["done:loop", "!loopleft>=:25", "!log:enter.in"], "repeat": 30, "retry": 5, "why": "the tape's running out and he isn't in yet: loop it again"}, {"id": "call", "op": "fixer", "do": "call", "target": "waitress", "when": ["log:turn.pressure.turned"], "retry": 2}, {"id": "to-door", "op": "enforcer", "do": "move", "to": "d:Office entrance", "when": ["log:loop.on"], "run": false, "late": 0}, {"id": "enter", "op": "enforcer", "do": "enter", "when": ["done:to-door", "free:enforcer", "loopleft>=:3"], "retry": 1}, {"id": "fixer-post", "op": "fixer", "do": "move", "to": [725, -5025], "when": ["log:call.waitress"]}, {"id": "scout-post", "op": "scout", "do": "move", "to": [725, -4625], "when": ["log:call.waitress"]}, {"id": "tech-post", "op": "tech", "do": "move", "to": [675, -4625], "when": ["log:enter.in"]}, {"id": "enforcer-hold", "op": "enforcer", "do": "move", "to": [2000, -6500], "when": ["log:enter.out"], "why": "20 m from every spot: out of the pistols' reach until the car is free"}, {"id": "step-in", "op": "enforcer", "do": "move", "to": [1700, -5900], "when": ["sincelog:fight.safe:30", "free:enforcer", "!log:fight.ambush"], "why": "the ambush hasn't sprung and he's waiting on nothing: walk on till it does"}, {"id": "draw-all", "op": "scout", "do": "draw", "when": ["log:fight.ambush"], "react": "expected"}, {"id": "draw-fixer", "op": "fixer", "do": "draw", "with": "draw-all"}, {"id": "draw-tech", "op": "tech", "do": "draw", "with": "draw-all"}, {"id": "draw-enforcer", "op": "enforcer", "do": "draw", "with": "draw-all"}, {"id": "focus-blocker-fixer", "op": "fixer", "do": "fire", "target": "$blocker", "when": ["blocker", "done:draw-all"], "retry": 1}, {"id": "focus-blocker-tech", "op": "tech", "do": "fire", "target": "$blocker", "with": "focus-blocker-fixer"}, {"id": "pull-back", "op": "enforcer", "do": "move", "to": [3800, -5000], "when": ["log:enforcer.warning"], "interrupt": true, "why": "the Enforcer warns at 3 HP: off the line", "unless": ["done:to-car-2"]}, {"id": "to-car", "op": "enforcer", "do": "move", "to": "d:Getaway bay", "when": ["log:car.free", "!hostilesnear:d%Getaway bay:16:2"], "interrupt": true, "retry": 1, "unless": ["log:enforcer.warning", "done:to-car-2"]}, {"id": "to-car-2", "op": "enforcer", "do": "move", "to": "d:Getaway bay", "when": ["log:fight.over"], "interrupt": true, "retry": 1, "unless": ["done:to-car"]}, {"id": "board", "op": "enforcer", "do": "board", "target": "car", "when": ["free:enforcer", "near:enforcer:d%Getaway bay:4"], "retry": 1}, {"id": "go", "op": "cell", "do": "go", "when": ["log:board.in"], "retry": 1, "react": "expected"}, {"id": "rescue-move", "op": "scout", "do": "move", "to": "d:Getaway bay", "when": ["log:board.in", "down:enforcer"], "interrupt": true, "why": "the Enforcer's down in the car with Vale: somebody has to drive"}, {"id": "rescue-board", "op": "scout", "do": "board", "target": "car", "when": ["done:rescue-move", "free:scout"], "retry": 1}]}