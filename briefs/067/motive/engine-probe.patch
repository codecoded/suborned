diff -ruN --exclude=bin --exclude=obj a/sim/Suborned.Sim/ProbeEnv.cs b/sim/Suborned.Sim/ProbeEnv.cs
--- a/sim/Suborned.Sim/ProbeEnv.cs	1970-01-01 07:00:00
+++ b/sim/Suborned.Sim/ProbeEnv.cs	2026-10-26 06:00:37
@@ -0,0 +1,14 @@
+// Motive brief 067 probe (scratch only, never sim/): environment switches. Every switch unset = engine 0.33.1.
+using System;
+using System.Globalization;
+namespace Suborned.Sim
+{
+    public sealed partial class Game
+    {
+        static string PEnv(string k) => Environment.GetEnvironmentVariable(k) ?? "";
+        static int PEnvInt(string k, int d) => PEnv(k).Length > 0 ? int.Parse(PEnv(k), CultureInfo.InvariantCulture) : d;
+        static readonly int ProbeRunClock = PEnvInt("PROBE_RUNCLOCK", 0);
+        static readonly bool ProbeK3 = PEnv("PROBE_K3") == "1";
+        readonly System.Collections.Generic.HashSet<string> probeCarPress = new System.Collections.Generic.HashSet<string>(StringComparer.Ordinal); Pt probeCarTo;
+    }
+}
