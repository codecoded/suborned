diff -ruN -x bin -x obj -x TestResults sim/Suborned.Sim/MF.cs out/scratch/motive-fight/tree/sim/Suborned.Sim/MF.cs
--- sim/Suborned.Sim/MF.cs	1970-01-01 07:00:00
+++ out/scratch/motive-fight/tree/sim/Suborned.Sim/MF.cs	2026-10-26 06:02:50
@@ -0,0 +1,160 @@
+// Motive's fight-proposal probe (brief 039 reopened, Sky 2026-10-26: "The fight should be a lot more fun"). SCRATCH ONLY: this file lives in
+// out/scratch/motive-fight/tree, a copy of engine 0.33.1; nothing here is in sim/. Every switch is off by default, so with no MF_* variable set
+// the engine plays byte-identical to 0.33.1 (checked by the harness's `mf identity`).
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+
+namespace Suborned.Sim
+{
+    public static class MF
+    {
+        static int I(string k, int d) { var v = Environment.GetEnvironmentVariable(k); return v != null && int.TryParse(v, NumberStyles.Integer, CultureInfo.InvariantCulture, out var x) ? x : d; }
+        /// <summary>Sticky focus: a fire order survives its target leaving reach or line (no fire.out-of-range end, no line lapse once it has
+        /// had reach); while the focus can't be shot the agent fires at will (whoever attacks it, else the nearest), then takes the focus back.</summary>
+        public static bool Sticky = I("MF_STICKY", 0) == 1;
+        /// <summary>Suppression: a body shot at (hit or miss) within PinTicks fires at PinMod per mille (PinCoverMod while still beside cover).</summary>
+        public static int PinTicks = I("MF_PIN", 0);
+        public static int PinMod = I("MF_PINMOD", 500);
+        public static int PinCoverMod = I("MF_PINCOVERMOD", -1); // -1: PinMod
+        /// <summary>A pinned hostile neither advances nor closes in (it keeps its spot or its cover).</summary>
+        public static bool PinHold = I("MF_PINHOLD", 0) == 1;
+        /// <summary>Only the cell pins (hostile shots pin nobody): a one-sided reading, for comparison.</summary>
+        public static bool PinCellOnly = I("MF_PINCELL", 0) == 1;
+        /// <summary>Readable cover: the lab's cover marks and snap (1.5 m) without the rest of the lab; the probe's sharp player seeks the marks.</summary>
+        public static bool Snap = I("MF_SNAP", 0) == 1;
+        /// <summary>The blocker is on his post when the ambush springs (a Pulse change: he waits there), not walking to it in the open.</summary>
+        public static bool BlockPosted = I("MF_BLOCKPOSTED", 0) == 1;
+        /// <summary>The blocker's post is the lane cover that shields him from the getaway car where one exists (a Pulse change): the three at the
+        /// car must flank, mark or grind him.</summary>
+        public static bool BlockShield = I("MF_BLOCKSHIELD", 0) == 1;
+        // the four signature moves (orders mf-mark, mf-talk, mf-screen, mf-burst), each with one recharge
+        public static int Recharge = I("MF_RECHARGE", 200);
+        public static int MarkTicks = I("MF_MARK_T", 100), MarkMod = I("MF_MARK_MOD", 1000), MarkReachCm = I("MF_MARK_REACH", 3000);
+        public static bool MarkCover = I("MF_MARK_COVER", 1) == 1; // the marked body's cover doesn't count against the cell
+        public static int TalkCm = I("MF_TALK_R", 1200), TalkShoutS = I("MF_TALK_S", 2); public static bool TalkHalf = I("MF_TALK_HALF", 1) == 1;
+        public static int ScreenTicks = I("MF_SCREEN_T", 80), ScreenCm = I("MF_SCREEN_R", 400), ScreenReachCm = I("MF_SCREEN_REACH", 2400);
+        public static int BurstTicks = I("MF_BURST_T", 40), BurstCm = I("MF_BURST_R", 300);
+        public static string Describe() => FormattableString.Invariant($"posted {BlockPosted} shield {BlockShield} snap {Snap} sticky {Sticky} pin {PinTicks}t@{PinMod}/{PinCoverMod} hold {PinHold} cellOnly {PinCellOnly} recharge {Recharge}t");
+    }
+
+    public sealed partial class Game
+    {
+        // probe state (not hashed: a probe run is compared by its outcome and log, never by its checkpoints)
+        internal string MfMarkT = ""; internal int MfMarkUntil = -1;
+        internal readonly List<(Pt at, int until)> MfScreens = new List<(Pt, int)>();
+        internal readonly Dictionary<string, int> MfPinUntil = new Dictionary<string, int>(StringComparer.Ordinal);
+        internal readonly int[] MfReady = { 0, 0, 0, 0 };
+        public int MfMoves; // moves taken
+        public readonly List<(int tick, string op, string what)> MfLog = new List<(int, string, string)>();
+
+        /// <summary>A screen (the Tech's steam) between a and b: integer distance from its centre to the segment within its radius.</summary>
+        bool MfScreened(Pt a, Pt b)
+        {
+            if (MfScreens.Count == 0) return false;
+            foreach (var (c, until) in MfScreens)
+            {
+                if (Tick >= until) continue;
+                long dx = b.X - a.X, dy = b.Y - a.Y, l2 = dx * dx + dy * dy;
+                long t = l2 == 0 ? 0 : ((long)(c.X - a.X) * dx + (long)(c.Y - a.Y) * dy);
+                long px, py;
+                if (l2 == 0 || t <= 0) { px = a.X; py = a.Y; }
+                else if (t >= l2) { px = b.X; py = b.Y; }
+                else { px = a.X + dx * t / l2; py = a.Y + dy * t / l2; }
+                long ex = c.X - px, ey = c.Y - py;
+                if (ex * ex + ey * ey <= (long)MF.ScreenCm * MF.ScreenCm) return true;
+            }
+            return false;
+        }
+
+        /// <summary>Pinned: shot at within MF.PinTicks (hit or miss), or under the Enforcer's covering fire.</summary>
+        internal bool MfPinned(Gun g)
+        {
+            if (MfPinUntil.TryGetValue(g.Id, out var u) && Tick < u) return true;
+            if (MF.PinTicks <= 0 || g.ShotByTick < 0 || Tick - g.ShotByTick > MF.PinTicks) return false;
+            if (MF.PinCellOnly && !IsOpId(g.ShotBy)) return false;
+            return true;
+        }
+
+        /// <summary>The probe's accuracy on top of the engine's: a pinned shooter, the Scout's mark.</summary>
+        int MfAcc(Gun g, string t, Pt from, Pt at, int acc, int cov)
+        {
+            if (IsOpId(g.Id) && t == MfMarkT && Tick < MfMarkUntil)
+            {
+                if (MF.MarkCover && cov < 1000 && cov > 0) acc = acc * 1000 / cov; // its cover doesn't count against the cell
+                acc = Math.Min(1000, acc * MF.MarkMod / 1000);
+            }
+            if (MfPinned(g))
+            {
+                int m = MF.PinCoverMod >= 0 && CoverMod(g.Id, from, at) < 1000 ? MF.PinCoverMod : MF.PinMod; // the shooter still beside cover against its target: it ducks
+                acc = acc * m / 1000;
+            }
+            return acc;
+        }
+
+        bool MfReadyFor(Op op) => Tick >= MfReady[(int)op.Id];
+        void MfSpent(Op op, string what) { MfReady[(int)op.Id] = Tick + MF.Recharge; MfMoves++; MfLog.Add((Tick, Sim.Op.Name(op.Id), what)); Note("mf." + what, $"{Sim.Op.Name(op.Id)}: {what}"); }
+
+        bool MfHostileUp(string id) { var h = HostileOf(id); if (h != null) return h.Present && !h.Down && h.Gun.St != "break" && h.Gun.St != "gone"; var gg = GunOf(id); return gg != null && !gg.Down && PosOf(id).HasValue && Combatant(id); }
+
+        /// <summary>The four moves as orders: mf-mark (Scout, a hostile within MarkReach with a line), mf-talk (Fixer, a rival within TalkCm with a
+        /// line, hurt or with one of its crew down: he breaks), mf-screen (Tech, a point within ScreenReach: a steam screen blocks every line
+        /// through it), mf-burst (Enforcer, a hostile within the carbine's max with a line, Vale held or not: it and everyone within BurstCm are
+        /// pinned for BurstTicks; no damage).</summary>
+        /// <summary>Whether the move would be taken now, without taking it (the probe player asks first, so the log stays readable).</summary>
+        public bool MfCan(Order o) { var op = OpOf(Sim.Op.Parse(o.Op)); if (op.Down || op.Inside || op.InCar || (op.Busy != null)) return false; mfDry = true; try { return MfMove(op, o).Length == 0; } finally { mfDry = false; } }
+        bool mfDry;
+
+        string MfMove(Op op, Order o)
+        {
+            if (!MfReadyFor(op)) return No("agent-busy", $"{o.Op}'s move recharges until {MfReady[(int)op.Id]}", tick: MfReady[(int)op.Id]);
+            switch (o.Do)
+            {
+                case "mf-mark":
+                {
+                    if (op.Id != OpId.Scout) return No("unknown-verb", "mark is the Scout's");
+                    if (!MfHostileUp(o.Target) || !(PosOf(o.Target) is Pt at)) return No("unknown-verb", "no hostile to mark");
+                    if (!G.Within(op.Pos, at, MF.MarkReachCm) || !Sees(op.Pos, at)) return No("out-of-range", "out of the Scout's reach or line");
+                    if (mfDry) return "";
+                    MfMarkT = o.Target; MfMarkUntil = Tick + MF.MarkTicks; MfSpent(op, "mark " + o.Target); return "";
+                }
+                case "mf-talk":
+                {
+                    if (op.Id != OpId.Fixer) return No("unknown-verb", "talk down is the Fixer's");
+                    var h = HostileOf(o.Target);
+                    if (h == null || !IsRival(h.Id) || !h.Present || h.Down || h.Gun.St == "break" || h.Gun.St == "gone") return No("unknown-verb", "no rival to talk down");
+                    var at = h.Pos(Tick);
+                    if (!G.Within(op.Pos, at, MF.TalkCm) || !Sees(op.Pos, at)) return No("out-of-range", "out of the Fixer's reach or line");
+                    bool shaken = MF.TalkHalf ? h.Gun.Health * 2 <= h.Gun.Max : h.Gun.Health < h.Gun.Max;
+                    if (!shaken) return No("unknown-verb", "he isn't shaken yet: hurt him to half");
+                    if (mfDry) return "";
+                    var rcp = RivalCarPose(); var carAt = rcp.HasValue ? Walk.NearestFree(rcp.Value.pos) ?? rcp.Value.pos : S.Stand(S.RivalsPark);
