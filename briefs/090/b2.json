{
 "picked": {
  "scene01_milena": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Have you eaten? You've looked at that office door all shift.",
   "wav": "scene01_milena_clone_s51.wav"
  },
  "scene02_inez": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Eat? With the bureau after me? Waiting tables I can't keep up.",
   "wav": "scene02_inez_clone_s51.wav"
  },
  "scene03_milena": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "I owe them too. We'll be buried with those cards half stamped.",
   "wav": "scene03_milena_clone_s51.wav"
  },
  "scene04_inez": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Then bury me somewhere I can sit down.",
   "wav": "scene04_inez_clone_s51.wav"
  },
  "scene05_milena": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "You'd get up to look at that door. Is it so handsome?",
   "wav": "scene05_milena_clone_s51.wav"
  },
  "scene06_inez": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Who says? Did Arthur say something? Who else has he told?",
   "wav": "scene06_inez_clone_s51.wav"
  },
  "scene07_milena": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "He said nothing, you goose. You just did.",
   "wav": "scene07_milena_clone_s51.wav"
  },
  "scene08_inez": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Yes, I'm seeing him. If the office hears, it costs us both...",
   "wav": "scene08_inez_clone_s51.wav"
  },
  "scene09_milena": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Not from me, they won't. Stop looking though. You can't afford it.",
   "wav": "scene09_milena_clone_s51.wav"
  },
  "scene10_larthi": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Bureau loan behind could be cleared. Arthur, office door could be used.",
   "wav": "scene10_larthi_clone_s51.wav"
  },
  "name01_hasti": {
   "seed": 52,
   "word_error": 0.0,
   "heard": "That's the rest paid. You owe the Bureau nothing, Miss Nicolau.",
   "wav": "name01_hasti_clone_s52.wav"
  },
  "name02_hasti": {
   "seed": 53,
   "word_error": 0.0,
   "heard": "Fair enough, Lukach. A couple of minutes. We'll be at the bay.",
   "wav": "name02_hasti_clone_s53.wav"
  },
  "name03_lukac": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "It's paid then. It's been a lean month for what exactly?",
   "wav": "name03_lukac_clone_s51.wav"
  },
  "name04_arthur": {
   "seed": 51,
   "word_error": 0.25,
   "heard": "It's only a door. Alright, I'm coming.",
   "wav": "name04_arthur_clone_s51.wav"
  },
  "name05_larthi": {
   "seed": 51,
   "word_error": 0.333,
   "heard": "Popovich has been missed.",
   "wav": "name05_larthi_clone_s51.wav"
  },
  "name06_arruns": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "LARTY with me",
   "wav": "name06_arruns_clone_s51.wav"
  },
  "name07_sethre": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "The loop's running. Two minutes, Larti.",
   "wav": "name07_sethre_clone_s51.wav"
  },
  "name08_popovic": {
   "seed": 51,
   "word_error": 0.0,
   "heard": "Councillor Popovich, I'll take my car now.",
   "wav": "name08_popovic_clone_s51.wav"
  },
  "shout01_arthur": {
