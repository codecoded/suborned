   },
   "drive": "Where a car may be (brief 023). The site carries a drive grid (sim/data/handover.site.json `drive`, the walk grid's window and cells, made by tools/sim/drive.ts): a cell is drivable when its centre lies on a carriageway (within half a plan road's width of its centreline), in a kerb bay of the civic block, or on a drive (the world's vehicle crossing from a carriageway over a dropped kerb and the pavement to a bay or yard: civic-block drives[], Splice; the Handover's one is service-drive, Apron Road to serviceBay). Pavements, forecourts, yards and squares are not drivable. Every car that moves on the street routes on drivable cells only, by the walk grid's A* (8 neighbours, no corner cutting, ties by cell index, string-pulled on drivable cells): the turned driver's drive to the service bay with Vale in the back (by the carriageway and the drive, never across a pavement; brief 059), the getaway car's Drive between its stands (cell.driveCar), and the rival car between its points (rulebook rivals). A car's place that lies off the drive grid stands at its nearest drivable cell within 6 m (ties: lowest cell); a place with none, or a car's place that no drive reaches from the pickup, rejects the site at load (unknown = reject). A car keeps off the kerb (brief 023, Keel with Pulse): on a carriageway its centre keeps the site's drive.lane (half the city's lane, life.json traffic.laneWidth) from the edge of the drivable ground where it can, on a drive or in a bay it keeps to the middle; the route never runs nearer an edge than its grid cells did (deterministic, sim Grid.CarRoute). Timing is car.pace's: the drive to the service bay runs at its surfaces' pace from Vale-in (car.pickup), then waits parked in the bay (the driver's camera block is retired, brief 059). Parked in the service bay the car faces the site's car.serviceFacing (the bay's long axis, nose away from the drive it came by). The getaway car leaves the street at Go along its exit lane (getaway.exit, held to the carriageway by SX-1); the rival car drives in, drops three, parks, follows, leaves on a tip and comes back (rulebook rivals). Cars never collide with cars (no rule reads it).",
   "pace": { "road": "v:car-road-cm-s", "yard": "v:car-yard-cm-s" },
-  "footprint": { "len": "v:car-len-cm", "w": "v:car-w-cm", "clear": "v:car-clear-cm", "reach": "v:car-reach-cm", "rule": "A standing car is ground nobody walks through (engine 0.33.1; brief 041, Sky playing 0.2.122: \"characters are walking through cars\"). Every car the mission simulates (car:getaway, car:official, car:rivals; the range's spawned cars) blocks, while it stands, the walk cells whose centres lie within its footprint (`len` along its heading, `w` across, centred on the car's point) grown by `clear` on every side; while it drives it blocks nothing. It stands at a stand or a bay, at its stops, parked, waiting with Vale, stopped where its driver went down or where it was disabled, and as a wreck. Its heading is the one the host draws: the getaway car its stand's facing, the official car its bay's long axis at the pickup (site car.blockFacing) and car.serviceFacing in the service bay, the rival car its stop's facing (rivals.car.facing), a stopped car the way it was driving. Every walk made while it stands goes round it (the walk grid's A* on the free cells it leaves; the grid's own cells never change): a walk that would end on its ground ends at the free cell nearest that point and steps in from there (a person getting into the car), and a walk from inside it (getting out) starts at the free cell nearest. A move order to its ground ends at that free cell (no step in). A walk already made when a car stops is not walked again. At the car is within `reach` of its body (no longer at-reach-cm of its centre): Board and a rival reaching Vale at the getaway car. A disabled official car's people stand beside it across its heading, the driver on the road side and Vale on the kerb side. The crowd's routine legs go round the cars standing when each leg sets out (read at the start of the tick): the legs built at load go round the mission's start cars (the getaway car at its first stand, the official car at the pickup); once a car stands elsewhere a leg that would cross it is walked again round the cars standing then." },
+  "footprint": { "len": "v:car-len-cm", "w": "v:car-w-cm", "clear": "v:car-clear-cm", "reach": "v:car-reach-cm", "rule": "A standing car is ground nobody walks through (engine 0.33.1; brief 041, Sky playing 0.2.122: \"characters are walking through cars\"). Every car the mission simulates (car:getaway, car:official, car:rivals; the range's spawned cars) blocks, while it stands, the walk cells whose centres lie within its footprint (`len` along its heading, `w` across, centred on the car's point) grown by `clear` on every side; while it drives it blocks nothing. It stands at a stand or a bay, at its stops, parked, waiting with Vale, stopped where its driver went down or where it was disabled, and as a wreck. Its heading is the one the host draws: the getaway car its stand's facing, the official car its bay's long axis at the pickup (site car.blockFacing) and car.serviceFacing in the service bay, the rival car its stop's facing (rivals.car.facing), a stopped car the way it was driving. Every walk made while it stands goes round it (the walk grid's A* on the free cells it leaves; the grid's own cells never change): a walk that would end on its ground ends at the free cell nearest that point and steps in from there (a person getting into the car), and a walk from inside it (getting out) starts at the free cell nearest. A move order to its ground ends at that free cell (no step in). When a car comes to stand, whoever stands on its ground steps to the free cell nearest, and a walk in hand that would cross its ground is walked again round it, to the same end, from where the walker is (engine 0.36.0, brief 079; an operative mid-act stays, his act holds him). The response unit's walk, made once at load, goes round the mission's start cars. At the car is within `reach` of its body (no longer at-reach-cm of its centre): Board and a rival reaching Vale at the getaway car. A disabled official car's people stand beside it across its heading, the driver on the road side and Vale on the kerb side. The crowd's routine legs go round the cars standing when each leg sets out (read at the start of the tick): the legs built at load go round the mission's start cars (the getaway car at its first stand, the official car at the pickup); once a car stands elsewhere a leg that would cross it is walked again round the cars standing then." },
   "pickup": { "valeIn": "v:vale-in-s", "rule": "Vale's car at the official bay (brief 059 K1–K4; GDD v0.25.0 §07; Sky's answer 3a). Vale always walks from the official door to his car (5:50 to 6:10) and gets in `valeIn` later. Unturned, his driver drives him away then: the mission fails vale-leaves. Turned, the driver drives him round to the service bay along the drive grid at car.pace (car.parks when it stops) and waits there with Vale in the back until the mission's close (schedule.over), whatever his day in the people file says; at the close, if no Take has begun, he drives Vale on and the mission fails vale-leaves. A Take begun before the close holds him until it ends. With no driver (down) the car waits and Vale stands by it. A Take at his car is in-car (no struggle, nothing to witness) only with the driver turned and the car parked round the back; at the front with a turned driver it is refused (driver-brings-vale), and while the car is driving round (car-not-parked). The driver's Call (the camera block) is retired (Motive M059-6.1)." },
   "paceRule": "A moving car drives each drive-grid cell at its surface's pace: `road` on a carriageway, `yard` on a drive or in a bay. The turned driver leaves the official bay with Vale in the back at Vale-in (car.pickup) and waits parked in the service bay until the close; the getaway car's Drive and the rival car keep the same paces (brief 059).",
   "tag": "S",
@@ -979,6 +981,7 @@
   "openRule": "Sky's open questions from brief 059 (decision log 23–25), each a value: S1 is answered (Sky 2026-10-25: no, the final fight always comes): the value fight-always, its rule in alwaysRule (fight.safe.leaveUnfought is retired into it: 1 is the old false and more, 0 the old true); S2 `loud.entry` (nearest, Sky 'yea': the loud fight's officers come from whichever of the response unit's entry (site fight.entry) and the mission's official entrances (the world's entrances of kind official) is the shortest grid walk to the getaway car's stand; response: always the response unit's entry); S3 the value rivals-follow-cm-s (280, run, Sky; the walk is 160).",
   "alwaysRule": "The final fight always comes (Sky's S1; Motive briefs/059/motive/s1-rulings.json M059-S1.2 to S1.5; GDD v0.25.0 §06, §07). With safe.always 1: (1) the gate: from the final fight's start until it is over, Go with Vale aboard is refused (car-held) while the fight's blocker is not out (down or gone). The blocker holds the car wherever he stands while he is up, not only on his lane post. Before a blocker is named, whoever is coming holds it: car:rivals while a member still rides in the rival car (the refusal's tick is the first step-out), a member walking back or due to wake (safe), or the officers on their way (loud). The hold within fight.hold or on the exit lane applies on top as always. Go without Vale (withdrawing by car) and the menu's Withdraw are not gated. (2) The late spring: the ambush springs as built (the Enforcer with Vale, not inside, within safe.ambush of the stand's car) or once Vale is in the car; the blocker is picked at the spring from the crew on foot, and if none is on foot then, at the tick the first one steps out, among those on foot (shortest walk, ties by id); each later arrival alerts as he steps out and fires weapons.aimNew after. (3) The floor (safe.floor): at the safe fight's start, count the members able (alive and not bound: a knocked-out one due to wake counts) and coming (on foot, in the rival car, or due back). If fewer than safe.floor, away members come back, the earliest at the stand first (ties by id), until the count reaches the floor or nobody away is left: the tipped car cuts its tip short, re-enters at rivals.car.entry and rides to the stand's rival stop, where the wheelman steps out `out` s later; the warned lookout walks back from rivals.posts.lookoutExit to his spot (rivals.recalled). Nothing spawns; a killed or bound member stays gone. (4) Crew destroyed: with no member able at the fight's start (all killed or bound, none recalled), the safe fight is over at once (rivals.wiped, fight why crew-destroyed) and the gate is open. 0 turns (1), (3) and (4) off: a cell gone before anyone holds the car leaves unfought (engine 0.32.0).",
   "unguarded": "Hiding in a held car loses (engine 0.34.0; Motive briefs/067/motive.md §2.3, motive-values.json M067-K3, from BAL-YARD-AT-WILL: the Enforcer downed in the car with Vale at 7:30.0 and the run idle to its end; GDD §06: once Vale is in the car the Enforcer is any operative, and hiding in a held car loses). (a) In the safe fight, with Vale in the getaway car, the car held (a holder stands: Motive's amendment, briefs/067/motive-square.md §4: a free car with the cell aboard waits for Go, and the rivals don't walk to it) and no drawn operative standing outside it (engine 0.35.2, Motive briefs/039/motive/rulings-0.35.1.md §2, Sky's yes 2026-10-27: an operative outside guards the car only drawn, gun out or drawing; an undrawn agent standing by is no guard, so a cell that never draws loses here instead of idling to the close), read as each tick starts (after the last tick's orders, so a Go given as the last Board lands is taken first): the rivals up and not broken, the blocker excepted (he keeps his lane), walk to the car, each to the side of it he comes to, firing as they walk and taking no cover or kite step on the way; the first within car.footprint.reach of its body takes Vale (fail rivals-reach-vale, as today: no drawn operative of the cell stands within cell.reach, engine 0.35.2). A drawn operative standing outside again (pressing F answers it), or the car no longer held, sends them back: each takes cover as an advancing rival does (ai.seek.rival, the Enforcer or the car as the foe). Logged rivals.for-car and rivals.back-to-cover. (b) The cell down: the tick the last operative goes down (in the car or not), the mission fails (cell-down), the fail camera on the shot that downed the last to fall. (c) Go needs a driver: Go is taken only with a standing operative in the car; with only the downed aboard it is refused car-no-driver (any standing operative may give it, from anywhere, once one is aboard). No new timer: the safe fight still ends by the cell's acts, (a), (b), Withdraw, or (loud) the seal. The walk is the fight AI's own movement (an advance to a point), not a routine.",
+  "spacing": { "clear": "v:body-clear-cm", "file": "v:body-file-ticks", "rule": "Nobody in a fight stands in anybody else (engine 0.36.0; brief 079, Sky: \"Rivals were overlapping each other\"). Two bodies may pass; where a body's walk ends, or where it stands with none, it claims. The bodies: a final-fight body, a member of the rival crew on foot, the response unit, a police unit, and an operative on the street (the operatives' own moves stay the player's: this rule never moves one). A walk that would end within `clear` of another's claim ends at the free walk cell nearest that place clear of every claim, and outside the car's hold and lane unless the place itself was inside (a blocker's lane point stays his; a walk to a car's door ends at the car). A stand or spot found taken this way gives way to that cell, which is the body's stand from then on. A body that stops mid-walk on another's claim takes the step to such a cell, firing as it walks. Officers sent in together from one entry come in file, `file` apart. A claim is read from the walks and stands already in the state, so nothing new is hashed and the same orders give the same places." },
   "holdRule": "The hold is entered only on purpose (engine 0.34.0; Motive briefs/067/motive-square.md, motive-values.json M067-SQ1; Pulse's motion): in the final fight a hostile's answer to fire never ends inside the getaway car's hold (`hold` of the car) or on its exit lane: a rival's step out of a shooter's line (the shielding cover, else the nearest free spot within 8 m with no line to him), a rival's step to cover while engaged, a police body's cover or close (fight.kite). If no spot outside serves, it stays where it stands. A walk to a post goes round the hold (the walk grid with the hold's ground closed: the rival crew to its spots, police and the response unit to their stands), unless the post or the walker is already inside it. Exceptions: the blocker (his lane is the road: he comes for the car) and the rivals walking to a held car with nobody outside (fight.unguarded a). An advance on the car or on an operative may enter the hold: that is coming for the car, and it holds. Logged car.held.<how> the first tick each body holds the car at a stand, <how> its reason for being there: blocker, press (for the held car, or the drawn crew for the Vale holder), advance, answer, post (its stand, spot or post, or the way to it); a gate hold by whoever is coming before a blocker is named logs nothing (Waymark's MC-11: no played script logs car.held.answer or car.held.post). Why: only a hostile that comes for the car holds it (MC-11); on the square without its planters the late car's man walked to his ambush spot straight past the car, after the whole cell had boarded a free one, and held it.",
   "hold": "v:fight-hold-m",
   "block": "v:fight-block-m",
diff --git a/sim/Suborned.Sim.Tests/BodySpacing.cs b/sim/Suborned.Sim.Tests/BodySpacing.cs
new file mode 100644
index 00000000..86747dd9
--- /dev/null
+++ b/sim/Suborned.Sim.Tests/BodySpacing.cs
@@ -0,0 +1,120 @@
+// Engine 0.36.0 (brief 079, Sky on the recorded fight, route loud-fight: "Players were walking through the car at the beginning", "Rivals were
+// overlapping each other"). Replays the repo's route scripts tick by tick and reads where everybody is. A test, not a scenario: it reads the
+// routes (as GateC037). Reads only: the checkpoint hash at the end must match Engine.Play's (ticking one at a time moves nothing).
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using IOPath = System.IO.Path; using File = System.IO.File;
+using Suborned.Sim;
+using Xunit;
+
+public class BodySpacingTests
+{
+    static readonly string Root = Engine.FindRoot(AppContext.BaseDirectory);
+    static Script Load(string id) => Script.Parse(File.ReadAllText(IOPath.Combine(Root, "contracts/missions/handover/routes", id + ".json")));
+
+    /// <summary>Plays a route one tick at a time; `read` sees the game after each tick's orders.</summary>
+    static Game Walk(Script s, Action<Game> read)
+    {
+        var g = Engine.New(Repo.Inputs, s.Start); int until = s.Until <= 0 ? Game.T(Repo.Inputs.SiteData.Over) : s.Until;
+        var list = s.Orders.Select((o, k) => (o, k)).OrderBy(x => x.o.Tick).ThenBy(x => x.k).ToList(); int next = 0;
+        for (int t = 0; t <= until; t++)
+        {
+            if (t > 0) g.RunTo(t);
+            if (g.Over && g.Tick != t) break;
+            while (next < list.Count && list[next].o.Tick == t) g.Issue(list[next++].o);
+            read(g);
+            if (g.Over) break;
+        }
+        g.Finish(); return g;
+    }
+
+    /// <summary>How deep p stands inside a car's body (cm), 0 outside.</summary>
+    static long Depth(Game g, Game.StandingCar c, Pt p)
+    {
+        long hx = c.Heading.X, hy = c.Heading.Y, n = Math.Max(1, G.Isqrt(hx * hx + hy * hy)), dx = p.X - c.At.X, dy = p.Y - c.At.Y;
+        long along = Math.Abs(dx * hx + dy * hy) / n, across = Math.Abs(dx * hy - dy * hx) / n;
+        return Math.Max(0, Math.Min(g.R.CarLenCm / 2 - along, g.R.CarWCm / 2 - across));
+    }
+
+    static IEnumerable<(string id, Pt at)> Fighters(Game g)
+    {
+        foreach (var m in g.Crew) if (m.Mode != CrewMode.Aboard && m.Mode != CrewMode.Gone && !m.Gun.Down && g.PosOf(m.Id) is Pt p) yield return (m.Id, p);
+        foreach (var h in g.Hostiles) if (!h.Id.StartsWith("rival", StringComparison.Ordinal) && h.Present && !h.Down && h.Gun.St != "gone") yield return (h.Id, h.Pos(g.Tick));
+    }
+
+    [Theory]
+    [InlineData("loud-fight")] [InlineData("loud")] [InlineData("fight-loud-wait-square")] [InlineData("fail-enforcer-down")]
+    public void TheResponseUnitWalksRoundTheStandingCar(string id)
+    {
+        var worst = new List<string>();
+        Walk(Load(id), g =>
+        {
+            foreach (var k in new[] { "security-1", "security-2" })
+                if (g.GunOf(k) is Gun gn && !gn.Down && g.PosOf(k) is Pt p)
+                    foreach (var c in g.StandingCars()) if (Depth(g, c, p) > 0) worst.Add($"{k} {Depth(g, c, p)} cm in {c.Id} at t{g.Tick}");
+        });
+        Assert.True(worst.Count == 0, $"{id}: {worst.Count} ticks, first {worst.FirstOrDefault()}");
+    }
+
+    [Fact]
+    public void NoOneStandsInTheCarThatParkedOnThem()
+    {
+        var hits = new List<string>(); int parked = 0;
+        Walk(Load("fail-vale-leaves"), g =>
+        {
+            var c = g.StandingCars().Where(x => x.Id == "car:rivals").ToList(); if (c.Count == 0) return; parked++;
+            var op = g.OpOf(OpId.Scout); if (Depth(g, c[0], op.Pos) > 0 && op.Walk == null) hits.Add($"t{g.Tick} {op.Pos}");
+        });
+        Assert.True(parked > 0, "the rival car parks in this route");
+        Assert.True(hits.Count <= 1, $"the Scout stands in the rival car for {hits.Count} ticks, first {hits.FirstOrDefault()}"); // the step off starts the tick after the car stops
+    }
+
+    [Theory]
+    [InlineData("loud-fight")] [InlineData("loud")] [InlineData("route-a")] [InlineData("route-g")]
+    public void NoTwoFightersStandInOneAnother(string id)
+    {
+        const int Radius = 25; // a body's half width (cm): closer than twice this, standing still, they overlap
+        var still = new Dictionary<string, (Pt at, int since)>(); var bad = new List<string>();
+        Walk(Load(id), g =>
+        {
+            var now = Fighters(g).GroupBy(x => x.id).Select(x => x.First()).ToList();
+            foreach (var (who, at) in now) if (!still.TryGetValue(who, out var s) || s.at != at) still[who] = (at, g.Tick);
+            for (int a = 0; a < now.Count; a++) for (int b = a + 1; b < now.Count; b++)
+            {
+                var (x, y) = (now[a], now[b]);
+                if (G.Dist(x.at, y.at) >= 2 * Radius) continue;
+                if (g.Tick - still[x.id].since >= 5 && g.Tick - still[y.id].since >= 5) bad.Add($"{x.id}+{y.id} {G.Dist(x.at, y.at)} cm at t{g.Tick} {x.at}");
+            }
+        });
+        Assert.True(bad.Count == 0, $"{id}: {bad.Count} ticks of two standing in one spot, first {bad.FirstOrDefault()}");
+    }
+
+    [Fact]
+    public void OfficersFromOneEntryComeInFile()
+    {
+        int together = 0, seen = 0;
+        Walk(Load("loud-fight"), g =>
+        {
+            var o = g.Hostiles.Where(h => h.Id.StartsWith("officer-", StringComparison.Ordinal) && h.Present && !h.Down).ToList(); if (o.Count < 2) return;
+            seen++; if (G.Dist(o[0].Pos(g.Tick), o[1].Pos(g.Tick)) < g.R.BodyClearCm && g.Tick > g.FightStart + g.R.BodyFileTicks + 1) together++;
+        });
+        Assert.True(seen > 0); Assert.True(together < 20, $"the two officers walk as one for {together} ticks");
+    }
+
+    [Fact]
+    public void ClearStopChangesNothingWhenNobodyIsNear()
+    {
+        // an uncrowded walk ends where it always did: route B's times are the check
+        var g = Engine.Play(Repo.Inputs, Load("route-b").Start, Load("route-b").Orders, Load("route-b").Until);
+        Assert.Equal(Outcome.Success, g.Result); Assert.Equal(4522, g.Tick);
+    }
+
+    [Theory]
+    [InlineData("loud-fight")] [InlineData("route-b")]
+    public void TickingOneAtATimeMovesNothing(string id)
+    {
+        var s = Load(id); var a = Engine.Play(Repo.Inputs, s.Start, s.Orders, s.Until); var b = Walk(s, _ => { });
+        Assert.Equal(Hash.Hex(a.Checkpoints[^1].hash), Hash.Hex(b.Checkpoints[^1].hash));
+    }
+}
