# Copy to .env (git-ignored; bun and docker compose both read it). Leave everything unset for the local stack.
# Machine that serves the stack (Mac Studio): bind to its Tailscale address only, never 0.0.0.0.
# SUBORNED_BIND=100.81.57.43
# Machine that uses it (MacBook Air): point at the server over Tailscale.
# SURREAL_URL=http://skys-mac-studio:18504
# EMBEDDING_URL=http://skys-mac-studio:18505
# Both: the same real password (the default is only fit for 127.0.0.1).
# SURREAL_PASS=
