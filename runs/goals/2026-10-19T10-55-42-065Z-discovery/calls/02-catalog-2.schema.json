{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "requirements",
              "outside-domain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 12
          }
        },
        "required": [
          "section",
          "disposition",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "minItems": 1,
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "section": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 20
          },
          "acceptance": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 12
            }
          },
          "terms": {
            "minItems": 2,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            }
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "risk": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 12
          }
        },
        "required": [
          "id",
          "title",
          "section",
          "quote",
          "acceptance",
          "terms",
          "dependsOn",
          "value",
          "effort",
          "risk",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "coverage",
    "requirements"
  ],
  "additionalProperties": false
}
