{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "edits": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "search": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "search",
          "replacement"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "edits"
  ],
  "additionalProperties": false
}
