{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "problem",
          "fix"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "summary",
    "faults"
  ],
  "additionalProperties": false
}
