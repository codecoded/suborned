{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "satisfied",
              "missing",
              "partial",
              "blocked",
              "unknown"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 8
                }
              },
              "required": [
                "path",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "risk": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "state",
          "explanation",
          "evidence",
          "value",
          "effort",
          "risk",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "features"
  ],
  "additionalProperties": false
}
