{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "className": {
      "type": "string",
      "pattern": "^Goal[A-Za-z0-9]+Tests$"
    },
    "code": {
      "type": "string",
      "minLength": 100,
      "maxLength": 40000
    },
    "minTests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "covers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "className",
    "code",
    "minTests",
    "covers"
  ],
  "additionalProperties": false
}
