  {"id":"to-car","op":"enforcer","do":"move","to":"service-drive","when":["!boxed","log:fight.ambush","!hostilesnear:service-drive:16:1"],"interrupt":true,"retry":1,"why":"the way out is clear and nobody stands by the car"},
