{
 "datum": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "lines": {
    "minItems": 1,
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
       "description": "short id, e.g. T2, trunk, circus"
      },
      "mode": {
       "type": "string",
       "enum": [
        "tram",
        "skyrail"
       ]
      },
      "name": {
       "type": "string",
       "maxLength": 60
      },
      "beyond": {
       "type": "string",
       "maxLength": 160,
       "description": "where the line goes off-sheet, or \"\" if it does not"
      },
      "paths": {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "short id, e.g. T2, trunk, circus"
         },
         "role": {
          "type": "string",
          "enum": [
           "running",
           "line",
           "loop"
          ],
          "description": "tram: running|loop; sky rail: line|loop"
         },
         "double": {
          "type": "boolean"
         },
         "pts": {
          "minItems": 2,
          "type": "array",
          "items": {
           "minItems": 2,
           "maxItems": 3,
           "type": "array",
           "items": {
            "type": "number"
           },
           "description": "[x, y] or [x, y, fillet radius m]"
          }
         }
        },
        "required": [
         "id",
         "role",
         "double",
         "pts"
        ],
        "additionalProperties": false
       }
      },
      "order": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "path ids end to end (\"-id\" runs a path against its drawn direction); [] = as listed"
      }
     },
     "required": [
      "id",
      "mode",
      "name",
      "beyond",
      "paths",
      "order"
     ],
     "additionalProperties": false
    }
   },
   "remove": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
     "description": "short id, e.g. T2, trunk, circus"
    },
    "description": "ids of existing lines to delete; [] for none"
   },
   "notes": {
    "maxItems": 8,
    "type": "array",
    "items": {
     "type": "string",
     "maxLength": 400
    }
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[0-9a-f]{24}$",
     "description": "a 24-hex passage id from the retrieved passages"
    },
    "description": "passage ids the proposal rests on"
   },
   "handoffs": {
    "description": "asks for another builder (not yourself), e.g. a line that must move for a stop to fit; omit when none",
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "owner": {
       "type": "string",
       "enum": [
        "Datum",
        "Vantage",
        "Pulse"
       ]
      },
      "blocking": {
       "type": "boolean",
       "description": "true: the candidate cannot be accepted until the owner acts; false: advisory"
      },
      "ask": {
       "type": "string",
       "minLength": 1,
       "maxLength": 400
      }
     },
     "required": [
      "owner",
      "blocking",
      "ask"
     ],
     "additionalProperties": false
    }
   }
  },
  "required": [
   "lines",
   "remove",
   "notes",
   "sources"
  ],
  "additionalProperties": false
 },
 "vantage": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "stops": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "line": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
       "description": "short id, e.g. T2, trunk, circus"
      },
      "id": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
       "description": "short id, e.g. T2, trunk, circus"
      },
      "name": {
       "type": "string",
       "maxLength": 60
      },
      "path": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
       "description": "short id, e.g. T2, trunk, circus"
      },
      "at": {
       "minItems": 2,
       "maxItems": 2,
       "type": "array",
       "items": {
        "type": "number"
       },
       "description": "exactly [x, y] in metres [x east, y north], plan origin at Crown Circus centre"
      },
      "length": {
       "description": "sky rail station length m",
       "type": "number"
      },
      "interchange": {
       "description": "\"<line>/<stop id>\" of the paired stop on another line",
       "type": "string"
      },
      "fronts": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
       "description": "id of the road or foot path whose public space the entrance fronts"
      }
     },
     "required": [
      "line",
      "id",
      "name",
      "path",
      "at",
      "fronts"
     ],
     "additionalProperties": false
    }
   },
   "notes": {
    "maxItems": 8,
    "type": "array",
    "items": {
     "type": "string",
     "maxLength": 400
    }
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[0-9a-f]{24}$",
     "description": "a 24-hex passage id from the retrieved passages"
    },
    "description": "passage ids the proposal rests on"
   },
   "handoffs": {
    "description": "asks for another builder (not yourself), e.g. a line that must move for a stop to fit; omit when none",
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "owner": {
       "type": "string",
       "enum": [
        "Datum",
        "Vantage",
        "Pulse"
       ]
      },
      "blocking": {
       "type": "boolean",
       "description": "true: the candidate cannot be accepted until the owner acts; false: advisory"
      },
      "ask": {
       "type": "string",
       "minLength": 1,
       "maxLength": 400
      }
     },
     "required": [
      "owner",
      "blocking",
      "ask"
     ],
     "additionalProperties": false
    }
   },
   "answers": {
    "description": "one entry per blocking hand-off addressed to you in the task; omit when there are none",
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "from": {
       "type": "string",
       "enum": [
        "Datum",
        "Vantage",
        "Pulse"
       ]
      },
      "ask": {
       "type": "string",
       "minLength": 1,
       "maxLength": 400,
       "description": "the hand-off ask, copied exactly"
      },
      "done": {
       "type": "boolean",
       "description": "true only if your output now does what was asked"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      }
     },
     "required": [
      "from",
      "ask",
      "done",
      "note"
     ],
     "additionalProperties": false
    }
   }
  },
  "required": [
   "stops",
   "notes",
   "sources"
  ],
  "additionalProperties": false
 },
 "pulse": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "lines": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "line": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
       "description": "short id, e.g. T2, trunk, circus"
      },
      "speed": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "cruising speed, m/s"
      },
      "headwaySec": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "dwellSec": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "required": [
      "line",
      "speed",
      "headwaySec",
      "dwellSec"
     ],
     "additionalProperties": false
    }
   },
   "journeys": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "legs": {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
          "description": "\"<line>/<stop id>\""
         },
         "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
          "description": "\"<line>/<stop id>\""
         }
        },
        "required": [
         "from",
         "to"
        ],
        "additionalProperties": false
       },
       "description": "ordered rides, one line per leg; a leg ends where you change lines and the next leg starts at its interchange partner"
      }
     },
     "required": [
      "legs"
     ],
     "additionalProperties": false
    }
   },
   "openQuestions": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "question": {
       "type": "string",
       "maxLength": 300
      },
      "for": {
       "type": "string",
       "enum": [
        "Motive",
        "Sky"
       ]
      },
      "why": {
       "type": "string",
       "maxLength": 300
      }
     },
     "required": [
      "question",
      "for",
      "why"
     ],
     "additionalProperties": false
    },
    "description": "what the GDD has not decided; never a price or a rule invented here"
   },
   "notes": {
    "maxItems": 8,
    "type": "array",
    "items": {
     "type": "string",
     "maxLength": 400
    }
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[0-9a-f]{24}$",
     "description": "a 24-hex passage id from the retrieved passages"
    },
    "description": "passage ids the proposal rests on"
   },
   "handoffs": {
    "description": "asks for another builder (not yourself), e.g. a line that must move for a stop to fit; omit when none",
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "owner": {
       "type": "string",
       "enum": [
        "Datum",
        "Vantage",
        "Pulse"
       ]
      },
      "blocking": {
       "type": "boolean",
       "description": "true: the candidate cannot be accepted until the owner acts; false: advisory"
      },
      "ask": {
       "type": "string",
       "minLength": 1,
       "maxLength": 400
      }
     },
     "required": [
      "owner",
      "blocking",
      "ask"
     ],
     "additionalProperties": false
    }
   },
   "answers": {
    "description": "one entry per blocking hand-off addressed to you in the task; omit when there are none",
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "from": {
       "type": "string",
       "enum": [
        "Datum",
        "Vantage",
        "Pulse"
       ]
      },
      "ask": {
       "type": "string",
       "minLength": 1,
       "maxLength": 400,
       "description": "the hand-off ask, copied exactly"
      },
      "done": {
       "type": "boolean",
       "description": "true only if your output now does what was asked"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      }
     },
     "required": [
      "from",
      "ask",
      "done",
      "note"
     ],
     "additionalProperties": false
    }
   }
  },
  "required": [
   "lines",
   "journeys",
   "openQuestions",
   "notes",
   "sources"
  ],
  "additionalProperties": false
 },
 "keel": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "verdict": {
    "type": "string",
    "enum": [
     "pass",
     "fail"
    ]
   },
   "summary": {
    "type": "string",
    "maxLength": 600
   },
   "faults": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "owner": {
       "type": "string",
       "enum": [
        "Datum",
        "Vantage",
        "Pulse"
       ]
      },
      "rule": {
       "type": "string",
       "maxLength": 40,
       "description": "plan checker rule id, or \"critic\" for a fault the checker cannot see"
      },
      "fault": {
       "type": "string",
       "maxLength": 500
      },
      "fix": {
       "type": "string",
       "maxLength": 400
      },
      "chunks": {
       "minItems": 1,
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{24}$",
        "description": "a 24-hex passage id from the retrieved passages"
       },
       "description": "passage ids that show the rule being broken"
      }
     },
     "required": [
      "owner",
      "rule",
      "fault",
      "fix",
      "chunks"
     ],
     "additionalProperties": false
    },
    "description": "empty when verdict is pass"
   },
   "sources": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[0-9a-f]{24}$",
     "description": "a 24-hex passage id from the retrieved passages"
    },
    "description": "passage ids the proposal rests on"
   }
  },
  "required": [
   "verdict",
   "summary",
   "faults",
   "sources"
  ],
  "additionalProperties": false
 }
}
