DEFINE TABLE IF NOT EXISTS chunk SCHEMALESS;
DEFINE TABLE IF NOT EXISTS corpus SCHEMALESS;
DEFINE ANALYZER IF NOT EXISTS words TOKENIZERS class, punct FILTERS lowercase, ascii;
DEFINE INDEX IF NOT EXISTS text_search ON chunk FIELDS text FULLTEXT ANALYZER words BM25;
DEFINE INDEX IF NOT EXISTS semantic_search ON chunk FIELDS embedding HNSW DIMENSION 384 DIST COSINE TYPE F32;
DEFINE INDEX IF NOT EXISTS chunk_key ON chunk FIELDS key UNIQUE;
DEFINE TABLE IF NOT EXISTS corpus SCHEMALESS;
