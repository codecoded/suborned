{
  "schema": "suborned.proofmap/1",
  "note": "Which proof sections a changed path can affect (brief 078; tools/game/proofdelta.ts). The first row whose glob matches a path decides it. run: a list of sections, or \"full\" (the whole proof), or \"none\" (the player cannot read it; such a path is not even hashed). A path no row matches runs the whole proof: that is the fail-safe, so add a row only with its reason. proofdelta.test.ts holds the HUD and proof rows to the sources: a section that reads a HudToolkit member or calls another proof's helper must be on that file's row. shots: the rows of shots.json the path can show in (none: the shots and budget steps skip it). seconds: each section's share of the 0.2.146 proof, for the estimate only (frame-time spots are out of the proof, `--spots`; r118 was thinned from 185 s).",
  "baseSeconds": 70,
  "sections": [
    { "id": "drive", "seconds": 28 },
    { "id": "driveClick", "seconds": 9 },
    { "id": "fireStop", "seconds": 9 },
    { "id": "ringCheck", "seconds": 9 },
    { "id": "act", "seconds": 9 },
    { "id": "dblClick", "seconds": 10 },
    { "id": "holdActs", "seconds": 35 },
    { "id": "done", "seconds": 18 },
    { "id": "levels", "seconds": 6 },
    { "id": "r29", "seconds": 98 },
    { "id": "r118", "seconds": 30 },
    { "id": "r059", "seconds": 29 },
    { "id": "r067", "seconds": 77 },
    { "id": "r123", "seconds": 21 },
    { "id": "r083", "seconds": 25 },
    { "id": "rings", "seconds": 8 },
    { "id": "fire", "seconds": 23 },
    { "id": "cars", "seconds": 25 },
    { "id": "hudClick", "seconds": 5 },
    { "id": "leash", "seconds": 15 },
    { "id": "holdRange", "seconds": 14 }
  ],
  "rows": [
    { "match": ["sim/data/**", "sim/Suborned.Sim/**", "unity/Assets/Suborned/Sim/**", "unity/Assets/StreamingAssets/**"], "run": "full", "why": "the engine and its inputs: every section plays on them" },
    { "match": ["out/world/**", "tools/world/**"], "run": "full", "why": "the world export: every section plays in it" },
    { "match": ["contracts/world/kit.json", "contracts/world/kit.schema.ts", "tools/kit/**", "tools/decokit/**", "unity/Assets/Suborned/Kit/**", "unity/Assets/Suborned/Kit.meta"], "run": "full", "why": "the kit: the pieces every picture is made of" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/GameBoot.cs*", "tools/game/proofgates.ts"], "run": "full", "why": "the proof's own driver and what its gate means" },

    { "match": ["**/*.test.ts", "tools/simview/**", "tools/game/batch.ts", "tools/game/cli.ts", "tools/game/proofdelta.ts", "tools/game/proofmap.json", "tools/game/proofset.ts", "tools/game/proofset.json", "tools/game/shots*", "tools/game/late*", "tools/game/tplong*", "tools/game/perfrow.ts", "tools/game/playing.ts", "tools/game/shrink.ts", "tools/game/walkfile.ts", "tools/game/ships.ts", "tools/game/briefstills.ts", "tools/game/fingerprint.ts", "tools/game/runtime-compile.ts", "tools/game/version.json", "tools/game/unity/**", "tools/game/closing-hash/**"], "run": "none", "why": "the batch's own tools: they judge the player, the player does not read them (the map's own edits count through each section's map hash)" },
    { "match": ["briefs/**", "runs/**", "courses/**", "GDD/**", ".claude/**", ".codex/**", "paid/**", "services/**", "testbed/**", "presentation/**", "README.md", "CLAUDE.md", "AGENTS.md", "compose.yaml", "package.json", "bun.lock", "bunfig.toml", "tsconfig.json", ".gitignore", ".mcp.json", ".env.example"], "run": "none", "why": "documents, evidence and repo plumbing: nothing the app is built from" },
    { "match": ["tools/paid/**", "tools/crew/**", "tools/storage/**", "tools/routines/**", "tools/rag/**", "tools/goals/**", "tools/levels/**", "tools/gen/**", "tools/lint/**", "tools/art-bible/**", "tools/art-quality/**", "tools/cover/**", "tools/qa/**", "tools/hud-budget/**", "tools/doctor.ts", "tools/verify.ts", "tools/drift-auto/**"], "run": "none", "why": "tools the player does not read and that write nothing into unity/ (the budget reader re-judges in its own step)" },
    { "match": ["unity/Assets/Scenes/HarbourDistrict-*", "unity/Assets/Scenes/FightRange.unity*", "unity/Assets/Suborned/Generated/Range/**"], "run": "none", "why": "written by the world and range builders, bakes differing byte to byte between runs: their inputs (the export, the builders) already count" },
    { "match": ["unity/Assets/Suborned/Tests/**", "unity/Assets/Suborned/Runtime/Play/ShotRunner.cs*", "unity/Assets/Suborned/Runtime/Play/LateRun.cs*", "unity/Assets/Suborned/Runtime/Play/TpLongRun.cs*", "unity/Assets/Suborned/Runtime/Play/Perf064.cs*", "unity/Assets/Suborned/Runtime/Play/BotRun*"], "run": [], "why": "runs only under its own flag, which has its own batch step (or bot rows): the proof's base (briefing, play, menu, frame times) still runs" },

    { "match": ["unity/Assets/Suborned/Runtime/Play/Proof29.cs*"], "run": ["r29", "done", "holdActs", "holdRange", "rings"], "why": "its section; ProofDone calls its Play and Route, ProofHold calls ProofDone" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/Proof059.cs*"], "run": ["r059"], "why": "its section" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/Proof067.cs*"], "run": ["r067"], "why": "its section" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/Proof118.cs*"], "run": ["r118", "levels"], "why": "its section; ProofLevels calls its Uncut" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/Proof123.cs*"], "run": ["r123"], "why": "its section" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/Proof083.cs*"], "run": ["r083"], "why": "its section" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/ProofDone.cs*"], "run": ["done", "holdActs", "holdRange", "rings"], "why": "its section; ProofHold calls its Still" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/ProofFire.cs*"], "run": ["act", "fire", "cars", "done", "holdActs", "holdRange", "rings"], "why": "its sections; ProofDone calls its ApproachInSight" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/ProofHold.cs*"], "run": ["holdActs", "holdRange", "rings"], "why": "its sections; ProofRings names its Range" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/ProofInput.cs*"], "run": ["driveClick", "fireStop", "ringCheck", "dblClick", "hudClick", "leash"], "why": "its sections" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/ProofLevels.cs*"], "run": ["levels"], "why": "its section" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/ProofRings.cs*"], "run": ["rings", "holdActs", "holdRange"], "why": "its section; ProofHold calls its DrawAll and RingsNow" },

    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.Cones.cs*", "unity/Assets/Suborned/Runtime/Play/HudToolkit.Seal.cs*", "unity/Assets/Suborned/Runtime/Play/HudToolkit.Mood.cs*", "unity/Assets/Suborned/Runtime/Play/HudToolkit.Reroute.cs*"], "run": ["r059", "r067", "r123", "hudClick", "r29", "done", "holdActs", "holdRange", "rings"], "shots": ["office-front-yaw210", "cafe-front-day"], "why": "the budgeted pictures (r059, r067, r123), the HUD click-through, and r29 (and done, which plays through Proof29), which read these" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.Done.cs*"], "run": ["r059", "r067", "r123", "hudClick", "done", "r118", "holdActs", "holdRange", "levels", "rings"], "shots": ["office-front-yaw210", "plate-pay-armed"], "why": "the budgeted pictures, the click-through, and done and r118, which read the chips and window marks" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.Hold.cs*"], "run": ["r083", "r059", "r067", "r123", "hudClick", "holdActs", "holdRange", "rings"], "shots": ["plate-pay-armed"], "why": "the budgeted pictures, the click-through, and the hold proofs (and rings, which the hold proof calls through), which read the pill's state" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.ActMark.cs*"], "run": ["r059", "r067", "r123", "hudClick", "holdActs", "holdRange", "done", "driveClick", "fireStop", "ringCheck", "dblClick", "leash", "rings"], "shots": ["plate-pay-armed", "office-front-yaw210"], "why": "the budgeted pictures and every proof that reads the pill's words" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.Fire.cs*"], "run": ["r059", "r067", "r123", "hudClick", "act", "fire", "cars", "holdActs", "holdRange", "rings", "done"], "shots": ["fight-loud-body", "fight-safe-body", "fight-loud-checkpoint"], "why": "the budgeted pictures, the click-through, and the fire and hold proofs, which read the portraits' place" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.Ring.cs*", "unity/Assets/Suborned/Runtime/Play/HudToolkit.TargetRings.cs*"], "run": ["r059", "r067", "r123", "hudClick", "ringCheck", "dblClick", "act", "holdActs", "holdRange", "done", "rings", "r29", "r118"], "shots": ["plate-pay-armed", "office-front-yaw210", "cafe-front-day"], "why": "the rings: the budgeted pictures and every proof that opens one" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.Less.cs*"], "run": ["r083", "r059", "r067", "r123", "hudClick", "r118", "rings", "fire", "levels"], "shots": ["fight-loud-body", "fight-safe-body", "fight-loud-checkpoint", "start-overhead-day", "office-front-yaw210"], "why": "the world marks: the budgeted pictures, the click-through, and the proofs that read the dead discs, the rings and the fighters' pips" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.cs*", "unity/Assets/Suborned/Runtime/Play/HudToolkit.Capture.cs*", "unity/Assets/Suborned/Runtime/Play/HudModel*", "unity/Assets/Suborned/Runtime/Play/PlayHud.cs*", "unity/Assets/Suborned/Runtime/Play/PlayText.cs*", "unity/Assets/Suborned/UI/**"], "run": ["r083", "drive", "driveClick", "fireStop", "ringCheck", "act", "dblClick", "holdActs", "done", "levels", "r29", "r118", "r059", "r067", "r123", "rings", "fire", "cars", "hudClick", "leash", "holdRange"], "shots": "all", "why": "the HUD's root, its capture, its model and its words: every section reads or pictures them" },
    { "match": ["unity/Assets/Suborned/Runtime/Play/HudToolkit.*"], "run": ["r059", "r067", "r123", "hudClick"], "shots": ["start-overhead-day", "plate-pay-armed", "fight-loud-body"], "why": "a part of the HUD no proof reads directly (Scope, Roster, Menu, Intel, Plate, Ground, Live, Lock, Rivals and the like): the budgeted pictures and the click-through" }
  ]
}
