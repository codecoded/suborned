{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "description": "short id, e.g. T2, trunk, circus"
          },
          "headwaySec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "dwellSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
                  "description": "\"<line>/<stop id>\""
                },
                "to": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
                  "description": "\"<line>/<stop id>\""
                },
                "sec": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "from",
                "to",
                "sec"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "line",
          "headwaySec",
          "dwellSec",
          "runs"
        ],
        "additionalProperties": false
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
            "description": "\"<line>/<stop id>\""
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
            "description": "\"<line>/<stop id>\""
          },
          "sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "via": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+\\/[A-Za-z0-9_-]+$",
              "description": "\"<line>/<stop id>\""
            },
            "description": "interchanges used; [] for none"
          }
        },
        "required": [
          "from",
          "to",
          "sec",
          "via"
        ],
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300
          },
          "for": {
            "type": "string",
            "enum": [
              "Motive",
              "Sky"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "question",
          "for",
          "why"
        ],
        "additionalProperties": false
      },
      "description": "what the GDD has not decided (e.g. whether boarding costs anything); never a price or a rule invented here"
    },
    "notes": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{24}$",
        "description": "a 24-hex passage id from the retrieved passages"
      },
      "description": "passage ids the proposal rests on"
    }
  },
  "required": [
    "lines",
    "journeys",
    "openQuestions",
    "notes",
    "sources"
  ],
  "additionalProperties": false
}
