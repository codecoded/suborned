:root {
    --ink: #17302f;
    --ink-2: #244442;
    --ink-deep: #0b1615;
    --cream: #f7f4ec;
    --ivory: #eee9da;
    --card-ivory: #fce4cc;
    --white: #ffffff;
    --deep-teal: #1f6c67;
    --seafoam: #72b5a7;
