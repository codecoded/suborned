    --chrome: #cbc6c3;
    --brass: #99784d;
    --turquoise: #1cb9c6;
    --turquoise-light: #60e0ea;
    --text-dim: #b0cdc7;
    --text-sea: #7ac4b4;
    --text-warm-ink: #46524e;
    --text-card: #2c3a38;
    --text-grey: #7a8c8a;
    --feed-where: #c8e0da;
    --kind-learn: #1f6c67;
    --kind-approach: #244c48;
    --kind-call: #306064;
    --kind-city: #607064;
    --kind-warn: #283436;
    --kind-fight: #0e1a1b;
    --stripe-warn: #ece9e0;
    --footer-result: #bae2d6;
    --footer-result-line: #629e92;
    --footer-live: #d6deda;
    --footer-live-line: #96aaa6;
    --panel-line: #d2e6e2;
